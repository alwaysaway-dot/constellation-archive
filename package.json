{
  "name": "constellation-archive",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "dev:lan": "vite --host 0.0.0.0 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "build:production": "npm run build && node scripts/prepare-cloudflare.mjs",
    "deploy:production": "wrangler deploy",
    "preview:production": "wrangler dev --ip 127.0.0.1 --port 4180",
    "deploy:preview": "wrangler deploy --config wrangler.preview.jsonc"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "0.186.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "wrangler": "4.151.0"
  }
}
